{
  "framework": "vite",
  "buildCommand": "cd joblify-frontend/joblify && npm install && npm run build",
  "outputDirectory": "joblify-frontend/joblify/dist",
  "installCommand": "cd joblify-frontend/joblify && npm install",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}