# =============================================================================
# Joblify web env template.
#
# This file is committed. NEVER put real secrets here.
# Pull real values from Vercel:   `vercel env pull .env.local`
# Add new values via:             `vercel env add <NAME>`
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Database — Neon Postgres (Vercel Marketplace)
# Auto-provisioned by the Neon integration. Neon also injects POSTGRES_*/PG*
# aliases (POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING, …); the app reads only
# these two — Prisma `url` (pooled) and `directUrl` (unpooled, for migrations).
# -----------------------------------------------------------------------------
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# -----------------------------------------------------------------------------
# Auth — Clerk (Vercel Marketplace)
# Auto-provisioned when you install Clerk.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# -----------------------------------------------------------------------------
# Cache + rate limit — Upstash Redis (Vercel Marketplace)
# -----------------------------------------------------------------------------
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# -----------------------------------------------------------------------------
# Search — Algolia (NOT on the Vercel Marketplace — create at dashboard.algolia.com).
# Search runs SERVER-SIDE (lib/search). Two keys, deliberately:
#   ALGOLIA_ADMIN_API_KEY   write/delete — used ONLY by indexing (reindexJob, cron)
#   ALGOLIA_SEARCH_API_KEY  a search-only key (ACL: search) — used by the public
#                           /api/v1/jobs/search route. If unset the route falls back
#                           to the admin key and logs a warning; set it.
# -----------------------------------------------------------------------------
ALGOLIA_APP_ID=""
ALGOLIA_ADMIN_API_KEY=""
ALGOLIA_SEARCH_API_KEY=""

# -----------------------------------------------------------------------------
# AI Gateway (native Vercel)
# Token is injected automatically in deploys; set for local dev.
# -----------------------------------------------------------------------------
AI_GATEWAY_API_KEY=""
# Model slugs are the GATEWAY's canonical ids — dotted (anthropic/claude-haiku-5.5),
# not Anthropic's dashed ones. Verify against https://ai-gateway.vercel.sh/v1/models.
# All optional; defaults are in lib/ai/gateway.ts.
#   AI_MODEL_FAST       résumé parse, JD skill extraction
#   AI_MODEL_SMART      bio coach
#   AI_MODEL_EMBEDDING  MUST return 1536-wide vectors (the pgvector columns are
#                       vector(1536)); text-embedding-3-small is natively 1536.
AI_MODEL_FAST=""
AI_MODEL_SMART=""
AI_MODEL_EMBEDDING=""
# "1" routes every model call only through providers with a zero-data-retention
# agreement. Requires a plan that offers ZDR routing (Pro/Enterprise); the Gateway
# fails the request closed if none is available, so leave unset otherwise.
AI_GATEWAY_ZDR=""

# -----------------------------------------------------------------------------
# Groq (optional, direct — not via the Gateway). A SEPARATE PROCESSOR: list it
# in /legal/processors before enabling it for any task.
# Each task tries its Groq models in order, then falls back to the Gateway model
# above. Nothing uses Groq unless a switch is set AND the key exists.
# -----------------------------------------------------------------------------
GROQ_API_KEY=""
#   AI_PROVIDER=groq               every task below
#   AI_PROVIDER_BIO_COACH=groq     per task (overrides AI_PROVIDER; "gateway" opts out)
#   AI_PROVIDER_RESUME_PARSE=groq
#   AI_PROVIDER_SKILL_EXTRACTION=groq
AI_PROVIDER=""
# Comma-separated Groq model ids per task; defaults are in lib/ai/groq.ts and come
# from GET https://api.groq.com/openai/v1/models (llama-3.3-70b-versatile is gone).
#   AI_GROQ_MODELS_BIO_COACH  AI_GROQ_MODELS_RESUME_PARSE  AI_GROQ_MODELS_SKILL_EXTRACTION

# -----------------------------------------------------------------------------
# Email — Resend (Vercel Marketplace)
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM="Joblify <noreply@joblify.example>"

# -----------------------------------------------------------------------------
# Storage — Vercel Blob (native). TWO stores; a store is private or public at
# creation time and cannot be switched:
#   private  résumés + generated CVs. Create with:
#              vercel blob create-store joblify-private --access private
#            Connect it to the project; Vercel injects BLOB_STORE_ID + OIDC, and a
#            static BLOB_READ_WRITE_TOKEN (needed to mint browser upload tokens).
#   public   company logos only (they are shown to anonymous visitors).
#            Connect it with the env prefix BLOB_PUBLIC so its token arrives as
#            BLOB_PUBLIC_READ_WRITE_TOKEN.
# Neither is optional in production: there is no inline/base64 fallback there.
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""
BLOB_PUBLIC_READ_WRITE_TOKEN=""

# -----------------------------------------------------------------------------
# Observability — Sentry (Vercel Marketplace)
# -----------------------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Bot protection — Vercel BotID is native; checkBotId() needs no env var.

# -----------------------------------------------------------------------------
# Cron + logging
# Vercel injects the matching `Authorization: Bearer ${CRON_SECRET}` header on
# scheduled invocations; /api/v1/cron/* refuse traffic without it.
# Generate: openssl rand -base64 48
# -----------------------------------------------------------------------------
CRON_SECRET=""
# Operator token for the detailed /api/v1/health report (falls back to CRON_SECRET).
# Anonymous callers only ever see { status }.
HEALTH_TOKEN=""
# pino level: trace|debug|info|warn|error|fatal (defaults: info in prod, debug in dev)
LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# Legacy data migration — one-shot Mongo → Neon (scripts/migrate-mongo-to-neon.ts)
# Only needed while the legacy Atlas DB is the source of truth.
# -----------------------------------------------------------------------------
MONGO_URL=""

# -----------------------------------------------------------------------------
# E2E tests (Playwright) — Clerk dev-instance users.
# Authed critical-path specs skip (not fail) when these are unset.
# -----------------------------------------------------------------------------
E2E_TEST_EMAIL_JOBSEEKER=""
E2E_TEST_EMAIL_COMPANY=""
E2E_TEST_PASSWORD=""

# -----------------------------------------------------------------------------
# Email compliance
# -----------------------------------------------------------------------------
# Signs the one-click unsubscribe links in the jobs digest (falls back to
# CRON_SECRET). The digest REFUSES to send without a signing secret and an
# absolute NEXT_PUBLIC_SITE_URL. Rotating it invalidates previously sent links.
EMAIL_UNSUBSCRIBE_SECRET=""
# CAN-SPAM: a valid physical postal address, appended to every digest.
EMAIL_POSTAL_ADDRESS=""

# -----------------------------------------------------------------------------
# Legal / contact points shown to users (see lib/site-config.ts). The defaults
# are non-routable placeholders; production logs a warning until these are set.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PRIVACY_EMAIL=""
NEXT_PUBLIC_ACCESSIBILITY_EMAIL=""
NEXT_PUBLIC_LEGAL_EMAIL=""
NEXT_PUBLIC_CONTROLLER_NAME=""
NEXT_PUBLIC_CONTROLLER_ADDRESS=""
# Where the data actually lives, published on /legal/processors. Leave unset
# until true; the page then says "Not yet published" instead of guessing.
NEXT_PUBLIC_REGION_HOSTING=""
NEXT_PUBLIC_REGION_DATABASE=""
NEXT_PUBLIC_REGION_REDIS=""
NEXT_PUBLIC_REGION_AUTH=""
NEXT_PUBLIC_REGION_SEARCH=""
NEXT_PUBLIC_REGION_EMAIL=""
NEXT_PUBLIC_REGION_MONITORING=""
NEXT_PUBLIC_REGION_AI=""
# Groq is listed on /legal/processors only for the tasks switched to it (AI_PROVIDER_*);
# set the region it really processes in, only when true.
NEXT_PUBLIC_REGION_GROQ=""

# -----------------------------------------------------------------------------
# Operations
# -----------------------------------------------------------------------------
# Salts the analytics IP hash (falls back to CRON_SECRET, then a per-process key).
ANALYTICS_HASH_SECRET=""
# Reconcile cron scan window, minutes. Default 1560 (26 h) fits the DAILY
# schedule; set to ~2x the interval if the cron is tightened (e.g. */15).
RECONCILE_WINDOW_MINUTES=""
# "1" lets a preview deployment run `prisma migrate deploy` — ONLY for previews
# that have their own database branch. Previews never migrate otherwise.
ALLOW_PREVIEW_MIGRATE=""
# "1" removes the AI-training crawler block from /robots.txt.
ROBOTS_ALLOW_AI_TRAINING=""
